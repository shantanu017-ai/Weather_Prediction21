# ==============================================================================
# GP-01: PRODUCTION ENVIRONMENT CONFIGURATION
# Copy to .env.production on production servers / CI-CD pipeline
# ==============================================================================

# Node.js API Service
PORT=5000
NODE_ENV=production
API_BASE_URL=https://gp01-api-gateway.onrender.com/api/v1
CORS_ORIGIN=https://gp01-air-quality.vercel.app

# Python FastAPI ML Backend Service
ML_SERVICE_URL=https://gp01-ml-service.onrender.com/ml/v1
PYTHONPATH=/app

# PostgreSQL + PostGIS Connection String
# Example Render or Supabase URL: postgresql://postgres:password@ep-host.region.render.com/airquality_db
DATABASE_URL=postgresql://postgres:your_secure_password@your_postgis_host:5432/airquality_db?sslmode=require

# Clerk Authentication (Production Keys from https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_live_your_clerk_secret_key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# External Data APIs
# OpenAQ API Key (Register at https://openaq.org/)
OPENAQ_API_KEY=your_production_openaq_key

# NASA FIRMS MAP_KEY (Register at https://firms.modaps.eosdis.nasa.gov/api/map_key/)
NASA_FIRMS_MAP_KEY=your_production_nasa_firms_key

# Open-Meteo Weather API
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# Frontend Public API URL (Used by Next.js browser client)
NEXT_PUBLIC_API_URL=https://gp01-api-gateway.onrender.com/api/v1
