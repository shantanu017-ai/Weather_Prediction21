# ==============================================================================
# GP-01: AIR QUALITY MONITORING & SOURCE ATTRIBUTION PLATFORM
# Environment Configuration Template
# ==============================================================================

# Node.js API Service
PORT=5000
NODE_ENV=development
API_BASE_URL=http://localhost:5000/api/v1
CORS_ORIGIN=http://localhost:3000

# Python FastAPI ML Backend
ML_SERVICE_URL=http://localhost:8000/ml/v1
PYTHONPATH=./

# PostgreSQL + PostGIS Connection
# Example: postgresql://postgres:postgres@localhost:5432/airquality_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/airquality_db

# Clerk Authentication (Get free keys from https://clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_placeholder_key
CLERK_SECRET_KEY=sk_test_placeholder_key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# External Data APIs
# OpenAQ API Key (Get from https://openaq.org/)
OPENAQ_API_KEY=your_openaq_api_key_here

# NASA FIRMS MAP_KEY (Get from https://firms.modaps.eosdis.nasa.gov/api/map_key/)
NASA_FIRMS_MAP_KEY=your_nasa_firms_map_key_here

# Open-Meteo Weather API (Free for non-commercial, no key required for basic tier)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# Mapbox Access Token (Optional: if using Mapbox instead of OpenStreetMap tiles)
NEXT_PUBLIC_MAPBOX_TOKEN=
